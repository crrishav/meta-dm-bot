# ---- Meta ----
# App Dashboard -> App Settings -> Basic -> App Secret
META_APP_ID=
META_APP_SECRET=
# Any random string YOU invent. You type the same one into the Webhooks setup form.
META_VERIFY_TOKEN=change-me-to-something-random
GRAPH_VERSION=v26.0

# Instagram API with Instagram Login - generate from the app's
# "API setup with Instagram login" page.
META_IG_ID=
META_IG_TOKEN=

# Separate "Instagram app" secret shown on that same page (Show button next
# to "Instagram app secret") - Meta signs X-Hub-Signature-256 on Instagram
# webhook payloads with THIS secret, not META_APP_SECRET.
META_IG_APP_SECRET=

# ---- Google AI Studio ----
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Behaviour ----
PERSONA_FILE=persona.md
# Wait this long for the customer to finish typing before replying (seconds)
DEBOUNCE_SECONDS=2
# When a human takes over (or the bot escalates), stay quiet this many hours
HANDOFF_HOURS=12
MAX_HISTORY=20

# ---- Supabase ----
# Durable long-term archive of every DM (text, voice, images) in its own
# ig_bot_* tables/bucket - see supabase_schema.sql. Service (secret) key, not
# the anon key, since this is a trusted backend writing server-side.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Public anon key (same project). Only used by app/dashboard.py to check a
# dashboard caller's own session token against PostgREST - never used to read
# or write data itself. Safe to copy straight from the website's own
# VITE_SUPABASE_ANON_KEY, since it's already public in that bundle.
SUPABASE_ANON_KEY=
